{
  "name": "configure-pc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "start": "npm run dev:app",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:init": "node db/init.js",
    "db:seed": "node db/seed.js",
    "db:import": "node db/import-localstorage.js",
    "db:backup": "node db/backup.js",
    "db:verify": "node db/verify.js",
    "db:test:api": "node db/api-e2e.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "server": "node --experimental-strip-types src/server/index.ts",
    "server:dev": "node --experimental-strip-types --watch src/server/index.ts",
    "db:analytics": "node db/analytics.js",
    "db:analytics:recent": "node db/analytics.js recent",
    "db:analytics:flows": "node db/analytics.js flows",
    "test:init:db": "node --experimental-strip-types tests/helpers/testDb.run.ts",
    "test:smoke": "npm run test:init:db && playwright test --grep @smoke",
    "test:smoke:mobile": "playwright test --project mobile-chrome --grep @smoke",
    "test:regression": "npm run test:init:db && playwright test tests/regression",
    "test:all": "npm run test:init:db && playwright test",
    "test:gen:from-logs": "node --experimental-strip-types scripts/gen-tests-from-logs.ts",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "better-sqlite3@13.0.3": true
  }
}
