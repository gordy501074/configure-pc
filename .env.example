# Confi — OpenRouter (AI) configuration.
# Copy to `.env` (git-ignored) and fill in your key. Never commit the real key.

# API key from https://openrouter.ai/keys (required to enable AI features).
OPENROUTER_API_KEY=

# Text model for the component description (cheap, fast, good RU).
# Default: deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL=

# Model for component image search (returns product-page URLs; server extracts
# og:image). Default: google/gemini-2.5-flash-lite
OPENROUTER_IMAGE_MODEL=

# Referer/title sent to OpenRouter for app attribution (optional).
OPENROUTER_APP_URL=
OPENROUTER_TITLE=

# Optional HTTP proxy. Required in environments where direct access to
# openrouter.ai is blocked (returns 403). Both forms are honored.
# Example: http://127.0.0.1:12334
HTTPS_PROXY=
HTTP_PROXY=