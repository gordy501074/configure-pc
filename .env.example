# Confi — OpenRouter (AI) configuration.
# Copy to `.env` (git-ignored) and fill in your key. Never commit the real key.
#
# Значения ниже соответствуют дефолтам кода (src/server/ai/openrouter.ts). Можно
# оставить их как есть или переопределить; пустое/пробельное значение трактуется
# как «не задано» — применится тот же дефолт.

# API key from https://openrouter.ai/keys (required to enable AI features).
OPENROUTER_API_KEY=

# Text model for the component description (cheap, fast, good RU).
# Default: deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Model for component image search (returns product-page URLs; server extracts
# og:image). Default: google/gemini-2.5-flash-lite
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-lite

# Model for the AI advisor chat (dialogue + requirement extraction; the build is
# assembled deterministically on the server from real catalog/prices).
# Default: google/gemini-2.5-flash-lite
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash-lite

# Referer/title sent to OpenRouter for app attribution (optional).
# Defaults: http://localhost:5173 and Confi
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_TITLE=Confi

# Optional HTTP proxy. Required in environments where direct access to
# openrouter.ai is blocked (returns 403). Both forms are honored, and
# OPENROUTER_PROXY takes precedence over them when set.
# Example: http://127.0.0.1:12334
# OPENROUTER_PROXY=
HTTPS_PROXY=
HTTP_PROXY=

# --- Хостинг / публикация ---
# Оставьте эти переменные закомментированными, чтобы применялись значения по
# умолчанию. Пустое значение и значение из пробелов трактуются как «не задано»
# (используется дефолт), поэтому `PORT=` не переопределит порт.
#
# Порт API-сервера. По умолчанию 8787. Некорректное значение (например `PORT=abc`)
# также откатывается к дефолту.
# PORT=8787
# Каталог с собранным SPA (`npm run build`). Если он существует, Express
# раздаёт фронтенд и fallback на index.html (production). По умолчанию `dist`
# (относительно корня репозитория; можно задать абсолютный путь).
# DIST_DIR=dist
# Каталог загруженных фото компонентов. По умолчанию `<repo>/uploads`.
# UPLOADS_DIR=uploads
# Путь к файлу SQLite. По умолчанию `<repo>/db/confi.db`. В Docker используется
# `/data/confi.db` (том confi-db).
# DB_PATH=db/confi.db